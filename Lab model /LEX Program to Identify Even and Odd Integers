%{
#include <stdio.h>
#include <stdlib.h>
%}

%%
[0-9]+ {
    int n = atoi(yytext);

    if (n % 2 == 0)
        printf("%d is Even\n", n);
    else
        printf("%d is Odd\n", n);
}

[ \t\n]+  ;

. {
    printf("Invalid input: %s\n", yytext);
}
%%

int yywrap()
{
    return 1;
}

int main()
{
    printf("Enter integers: ");
    yylex();
    return 0;
}
