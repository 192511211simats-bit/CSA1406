#include <stdio.h>
#include <string.h>

char input[100];
int pos = 0;

void A()
{
    if (input[pos] == 'b')
    {
        printf("A -> bA\n");
        pos++;
        A();
    }
    else if (input[pos] == 'c')
    {
        printf("A -> c\n");
        pos++;
    }
}

void S()
{
    if (input[pos] == 'a')
    {
        printf("S -> aA\n");
        pos++;
        A();
    }
}

int main()
{
    printf("Enter input string: ");
    scanf("%s", input);

    printf("\nParsing operations:\n");

    S();

    if (input[pos] == '\0')
        printf("\nString Accepted\n");
    else
        printf("\nString Rejected\n");

    return 0;
}
